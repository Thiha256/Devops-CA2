# =====================================================================
# Inventory — which server(s) Ansible provisions.
# Implemented by: Lin Htut Win — DevOps component (Ansible / IaC)
#
# PLACEHOLDERS — put your real values in your local copy (never commit them):
#   ansible_host                 = your EC2 public IP or DNS hostname
#   ansible_ssh_private_key_file = path to your AWS .pem key
# =====================================================================
[aws]
rp-app ansible_host=YOUR_EC2_IP_OR_HOSTNAME ansible_ssh_private_key_file=~/.ssh/YOUR_KEY.pem

[aws:vars]
ansible_user=ubuntu
ansible_python_interpreter=/usr/bin/python3
