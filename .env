# Shared secret the scheduled n8n workflow must pass to trigger reminder emails,
# e.g. GET /api/notifications/run-reminders?token=YOUR_SECRET
CRON_SECRET=change-me

# --- Fines ---
FINE_RATE_PER_DAY=1   # dollars charged per day a return is late
