<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Laptop Rental</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light">

<%- include("partials/adminNavbar") %>

<div class="d-flex gap-4 p-4 align-items-start">
    <%- include("partials/adminSidebar") %>

    <main class="container py-4">

        <a href="/admin/inventory/<%= model.id %>" class="text-success text-decoration-none small fw-semibold d-inline-block mb-3">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to Asset List
        </a>

        <% if (error) { %>
            <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
                <i class="fa-solid fa-circle-exclamation"></i>
                <span><%= error %></span>
            </div>
        <% } %>

        <header class="bg-white border rounded-4 p-4 mb-4">
            <span class="text-success fw-bold text-uppercase small">Inventory Management</span>
            <h2 class="fw-bold my-1">Add New Asset <span class="text-muted fw-normal">| <%= model.name %></span></h2>
        </header>

        <section class="bg-white border rounded-4 p-4">
            <form action="/admin/inventory/<%= model.id %>/assets/new" method="POST" class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold small">Asset ID <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text">LAP</span>
                        <input type="text" name="asset_number" class="form-control" value="<%= asset_number %>" placeholder="e.g. 11" required>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold small">Serial Number <span class="text-danger">*</span></label>
                    <input type="text" name="serial_no" class="form-control" value="<%= serial_no %>" required>
                </div>

                <div class="col-12 d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-success fw-bold px-4">Add Asset</button>
                    <a href="/admin/inventory/<%= model.id %>" class="btn btn-outline-secondary px-4">Cancel</a>
                </div>
            </form>
        </section>

    </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>