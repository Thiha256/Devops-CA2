<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Admin Profile</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-light">

<%- include("partials/adminNavbar") %>

<div class="d-flex gap-4 p-4 align-items-start">

    <%- include("partials/adminSidebar") %>

    <main class="flex-grow-1">

        <section class="bg-white border rounded-4 p-4 mb-4">
            <span class="text-success fw-bold text-uppercase small">Admin Account</span>
            <h2 class="fw-bold my-2">Admin Profile</h2>
            <p class="text-muted mb-0">
                Your account details and a log of your recent admin actions.
            </p>
        </section>

        <section class="bg-white border rounded-4 p-4 mb-4">
            <h5 class="fw-bold mb-3">
                <i class="fa-solid fa-user-shield me-2 text-primary"></i>
                Admin Information
            </h5>

            <div class="row g-3">

                <div class="col-md-6">
                    <div class="border rounded-4 p-3 bg-light">
                        <p class="text-muted small mb-1">Name</p>
                        <h6 class="fw-bold mb-0"><%= admin.name %></h6>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="border rounded-4 p-3 bg-light">
                        <p class="text-muted small mb-1">Email</p>
                        <h6 class="fw-bold mb-0"><%= admin.email %></h6>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="border rounded-4 p-3 bg-light">
                        <p class="text-muted small mb-1">Resource Centre</p>
                        <h6 class="fw-bold mb-0">
                            Republic Polytechnic Resource Centre
                        </h6>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="border rounded-4 p-3 bg-light">
                        <p class="text-muted small mb-1">Account Status</p>
                        <span class="badge bg-success rounded-pill">Active</span>
                    </div>
                </div>

            </div>
        </section>

        <!-- Activity Log: every action this admin takes, from the audit_log table -->
        <section class="bg-white border rounded-4 p-4 mb-4">
            <%
                function auditStyle(type) {
                    switch (type) {
                        case 'login':        return { icon: 'fa-right-to-bracket', colour: 'primary'   };
                        case 'approve':      return { icon: 'fa-circle-check',      colour: 'success'   };
                        case 'reject':       return { icon: 'fa-circle-xmark',      colour: 'danger'    };
                        case 'return':       return { icon: 'fa-rotate-left',       colour: 'secondary' };
                        case 'model_add':    return { icon: 'fa-plus',              colour: 'primary'   };
                        case 'model_edit':   return { icon: 'fa-pen',               colour: 'warning'   };
                        case 'model_delete': return { icon: 'fa-trash',             colour: 'danger'    };
                        case 'asset_add':    return { icon: 'fa-plus',              colour: 'success'   };
                        case 'asset_edit':   return { icon: 'fa-pen',               colour: 'warning'   };
                        case 'asset_delete': return { icon: 'fa-trash',             colour: 'danger'    };
                        default:             return { icon: 'fa-clock',             colour: 'secondary' };
                    }
                }
                const chips = [
                    { key: 'all',       label: 'All'       },
                    { key: 'logins',    label: 'Logins'    },
                    { key: 'decisions', label: 'Decisions' },
                    { key: 'inventory', label: 'Inventory' }
                ];
            %>
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <h5 class="fw-bold mb-0">
                    <i class="fa-solid fa-clock-rotate-left me-2 text-primary"></i>Activity Log
                </h5>
                <div class="d-flex gap-2 flex-wrap">
                    <% chips.forEach(function (ch) { %>
                        <a href="/admin/profile<%= ch.key === 'all' ? '' : '?filter=' + ch.key %>"
                           class="badge rounded-pill text-decoration-none <%= filter === ch.key ? 'bg-primary text-white' : 'bg-light text-secondary border' %>"
                           style="padding:6px 14px; font-size:12px;">
                            <%= ch.label %>
                        </a>
                    <% }); %>
                </div>
            </div>

            <% if (activity.length === 0) { %>
                <p class="text-muted text-center py-4 mb-0">No activity recorded yet.</p>
            <% } else { %>
                <ul class="list-unstyled mb-0">
                    <% activity.forEach(function (a) {
                        const s = auditStyle(a.action_type); %>
                        <li class="d-flex align-items-center gap-3 border-bottom py-3">
                            <div class="rounded-circle bg-<%= s.colour %> bg-opacity-10 text-<%= s.colour %> d-flex align-items-center justify-content-center flex-shrink-0" style="width:40px; height:40px;">
                                <i class="fa-solid <%= s.icon %>"></i>
                            </div>
                            <div class="flex-grow-1"><%= a.description %></div>
                            <small class="text-muted text-nowrap">
                                <%= new Date(a.created_at).toLocaleString('en-SG', { day:'numeric', month:'short', hour:'numeric', minute:'2-digit' }) %>
                            </small>
                        </li>
                    <% }); %>
                </ul>
            <% } %>
        </section>

        <section class="bg-white border rounded-4 p-4">

            <h5 class="fw-bold mb-3">
                <i class="fa-solid fa-bolt me-2 text-primary"></i>
                Quick Actions
            </h5>

            <div class="d-flex flex-wrap gap-2">

                <a href="/admin" class="btn btn-outline-primary rounded-3">
                    Browse Inventory
                </a>

                <a href="/admin/loans" class="btn btn-outline-primary rounded-3">
                    Review Loan Requests
                </a>

                <a href="/admin/reports" class="btn btn-outline-primary rounded-3">
                    View Reports
                </a>

                <a href="/logout" class="btn btn-outline-danger rounded-3">
                    Logout
                </a>

            </div>

        </section>

    </main>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>