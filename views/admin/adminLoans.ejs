<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Active Loans & Requests · Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="rp-app-bg">

<%- include("partials/adminNavbar") %>

<div class="d-flex gap-4 p-4 align-items-start">
    <%- include("partials/adminSidebar") %>

    <main class="container py-4">

        <% if (error) { %>
            <div data-flash="danger" data-flash-message="<%= error %>" class="d-none"></div>
        <% } %>
        <% if (success) { %>
            <div data-flash="success" data-flash-message="<%= success %>" class="d-none"></div>
        <% } %>

        <header class="bg-white border rounded-4 p-4 mb-4">
            <span class="text-success fw-bold text-uppercase small">Loan Management</span>
            <h2 class="fw-bold my-1">Requests &amp; Active Loans</h2>
            <p class="text-muted mb-0">Approve or reject pending requests, and track every laptop currently on loan.</p>
        </header>

        <!-- PENDING LOAN REQUESTS -->
        <section class="bg-white border rounded-4 p-4 mb-4">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h5 class="fw-bold mb-0"><i class="fa-solid fa-file-signature me-2 text-primary"></i>Pending Loan Requests</h5>
                <span class="badge bg-warning text-dark rounded-pill"><%= pendingRequests.length %> pending</span>
            </div>

            <% if (pendingRequests.length === 0) { %>
                <p class="text-muted mb-0">No requests are waiting for approval. 🎉</p>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr class="text-muted small text-uppercase">
                                <th>Student</th>
                                <th>Model</th>
                                <th>Reason</th>
                                <th>Remarks</th>
                                <th>Requested On</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% pendingRequests.forEach(function(r) { %>
                                <tr>
                                    <td class="fw-semibold"><%= r.studentName %></td>
                                    <td><%= r.modelName %></td>
                                    <td><%= r.reasonLabel %></td>
                                    <td class="text-muted small"><%= r.remarks || "—" %></td>
                                    <td><%= r.dateLabel %></td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-success rounded-3 review-btn"
                                                data-decision="approve"
                                                data-request-id="<%= r.request_id %>"
                                                data-model="<%= r.modelName %>"
                                                data-student="<%= r.studentName %>">
                                            <i class="fa-solid fa-check me-1"></i>Approve
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-3 review-btn"
                                                data-decision="reject"
                                                data-request-id="<%= r.request_id %>"
                                                data-model="<%= r.modelName %>"
                                                data-student="<%= r.studentName %>">
                                            <i class="fa-solid fa-xmark me-1"></i>Reject
                                        </button>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </section>

        <!-- ACTIVE LOANS -->
        <section class="bg-white border rounded-4 p-4">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h5 class="fw-bold mb-0"><i class="fa-solid fa-laptop me-2 text-primary"></i>Active Loans</h5>
                <span class="badge bg-primary rounded-pill"><%= activeLoans.length %> on loan</span>
            </div>

            <% if (activeLoans.length === 0) { %>
                <p class="text-muted mb-0">No laptops are currently on loan.</p>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr class="text-muted small text-uppercase">
                                <th>Loan ID</th>
                                <th>Student</th>
                                <th>Model</th>
                                <th>Borrowed</th>
                                <th>Due</th>
                                <th>Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% activeLoans.forEach(function(l) { %>
                                <tr>
                                    <td class="text-muted small">RP-LOAN-<%= String(l.loan_id).padStart(3, "0") %></td>
                                    <td class="fw-semibold"><%= l.studentName %></td>
                                    <td><%= l.modelName %></td>
                                    <td><%= l.borrowLabel %></td>
                                    <td><%= l.dueLabel %></td>
                                    <td>
                                        <% if (l.overdue) { %>
                                            <span class="badge bg-danger rounded-pill">Overdue by <%= Math.abs(l.daysRemaining) %> day<%= Math.abs(l.daysRemaining) === 1 ? "" : "s" %></span>
                                        <% } else { %>
                                            <span class="badge bg-success rounded-pill">On Loan — <%= l.daysRemaining %> day<%= l.daysRemaining === 1 ? "" : "s" %> left</span>
                                        <% } %>
                                    </td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-3 return-btn"
                                                data-loan-id="<%= l.loan_id %>"
                                                data-model="<%= l.modelName %>"
                                                data-student="<%= l.studentName %>"
                                                data-loan-label="RP-LOAN-<%= String(l.loan_id).padStart(3, '0') %>">
                                            <i class="fa-solid fa-rotate-left me-1"></i>Return
                                        </button>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </section>

    </main>
</div>

<%- include("partials/adminFooter") %>

<!-- Return laptop modal: admin sets the resulting status + reason -->
<div class="modal fade" id="returnModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="POST" id="returnForm" class="modal-content rounded-4">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-rotate-left me-2 text-danger"></i>Return Laptop</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">
                    Returning <strong id="returnModelName"></strong>
                    (<span id="returnLoanLabel"></span>) borrowed by <strong id="returnStudent"></strong>.
                </p>

                <div class="mb-3">
                    <label class="form-label fw-semibold small">Laptop status after return</label>
                    <select name="status" id="returnStatus" class="form-select" required>
                        <option value="available">Available — ready to loan again</option>
                        <option value="maintenance">Maintenance — needs servicing</option>
                    </select>
                </div>

                <div class="mb-1" id="reasonWrap" style="display:none;">
                    <label class="form-label fw-semibold small">Reason / notes</label>
                    <textarea name="reason" id="returnReason" class="form-control" rows="3"
                              placeholder="e.g. cracked screen, battery won't charge"></textarea>
                    <div class="form-text">Shown against the laptop while it's under maintenance.</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-danger rounded-3">
                    <i class="fa-solid fa-check me-1"></i>Confirm Return
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Review request modal: admin approves or rejects, with optional remarks -->
<div class="modal fade" id="reviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="POST" id="reviewForm" class="modal-content rounded-4">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="reviewTitle">Review Request</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">
                    <span id="reviewDecisionText"></span>
                    <strong id="reviewModel"></strong> for <strong id="reviewStudent"></strong>.
                </p>

                <!-- Loan dates: only shown when approving -->
                <div id="reviewDatesWrap" style="display:none;">
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Start date</label>
                            <input type="date" name="start_date" id="reviewStartDate" class="form-control">
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Due date</label>
                            <input type="date" name="due_date" id="reviewDueDate" class="form-control">
                        </div>
                    </div>
                </div>

                <div class="mb-1">
                    <label class="form-label fw-semibold small">Remarks (optional)</label>
                    <textarea name="remarks" id="reviewRemarks" class="form-control" rows="3"
                              placeholder="Add a note for the student (e.g. reason for the decision)"></textarea>
                    <div class="form-text">Saved with the request and shown to the student.</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" id="reviewSubmit" class="btn rounded-3">Confirm</button>
            </div>
        </form>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    (function () {
        const modalEl = document.getElementById("returnModal");
        const modal = new bootstrap.Modal(modalEl);
        const form = document.getElementById("returnForm");
        const statusSel = document.getElementById("returnStatus");
        const reasonWrap = document.getElementById("reasonWrap");
        const reasonInput = document.getElementById("returnReason");

        // Show the reason field (and require it) only when Maintenance is picked.
        function syncReason() {
            const isMaint = statusSel.value === "maintenance";
            reasonWrap.style.display = isMaint ? "block" : "none";
            reasonInput.required = isMaint;
            if (!isMaint) reasonInput.value = "";
        }
        statusSel.addEventListener("change", syncReason);

        document.querySelectorAll(".return-btn").forEach(function (btn) {
            btn.addEventListener("click", function () {
                form.action = "/admin/loans/" + btn.dataset.loanId + "/return";
                document.getElementById("returnModelName").textContent = btn.dataset.model;
                document.getElementById("returnLoanLabel").textContent = btn.dataset.loanLabel;
                document.getElementById("returnStudent").textContent = btn.dataset.student;
                statusSel.value = "available";
                syncReason();
                modal.show();
            });
        });
    })();

    // Approve / Reject: same popup, remarks optional. The clicked button says
    // which decision it is, and that sets the form action + labels.
    (function () {
        const modal = new bootstrap.Modal(document.getElementById("reviewModal"));
        const form = document.getElementById("reviewForm");
        const title = document.getElementById("reviewTitle");
        const decisionText = document.getElementById("reviewDecisionText");
        const modelEl = document.getElementById("reviewModel");
        const studentEl = document.getElementById("reviewStudent");
        const remarks = document.getElementById("reviewRemarks");
        const submit = document.getElementById("reviewSubmit");
        const datesWrap = document.getElementById("reviewDatesWrap");
        const startDate = document.getElementById("reviewStartDate");
        const dueDate = document.getElementById("reviewDueDate");

        // Format a Date as YYYY-MM-DD for a <input type="date">.
        function ymd(d) { return d.toISOString().slice(0, 10); }

        document.querySelectorAll(".review-btn").forEach(function (btn) {
            btn.addEventListener("click", function () {
                const isApprove = btn.dataset.decision === "approve";

                form.action = "/admin/loans/requests/" + btn.dataset.requestId + "/" + btn.dataset.decision;
                title.textContent = isApprove ? "Approve Request" : "Reject Request";
                decisionText.textContent = isApprove ? "Approving the request for" : "Rejecting the request for";
                modelEl.textContent = btn.dataset.model;
                studentEl.textContent = btn.dataset.student;
                remarks.value = "";

                // Loan dates only apply to approval. Default: start = today,
                // due = one month later. Both required when approving.
                if (isApprove) {
                    const today = new Date();
                    const inOneMonth = new Date(today);
                    inOneMonth.setMonth(inOneMonth.getMonth() + 1);

                    startDate.value = ymd(today);
                    startDate.min = ymd(today);
                    dueDate.value = ymd(inOneMonth);
                    dueDate.min = ymd(today);

                    datesWrap.style.display = "block";
                    startDate.required = true;
                    dueDate.required = true;
                } else {
                    datesWrap.style.display = "none";
                    startDate.required = false;
                    dueDate.required = false;
                    startDate.value = "";
                    dueDate.value = "";
                }

                submit.className = "btn rounded-3 " + (isApprove ? "btn-success" : "btn-danger");
                submit.innerHTML = isApprove
                    ? '<i class="fa-solid fa-check me-1"></i>Approve'
                    : '<i class="fa-solid fa-xmark me-1"></i>Reject';

                modal.show();
            });
        });

        // Keep the due date on/after the start date as the admin changes it.
        startDate.addEventListener("change", function () {
            dueDate.min = startDate.value;
            if (dueDate.value && dueDate.value < startDate.value) dueDate.value = startDate.value;
        });
    })();
</script>
</body>
</html>
