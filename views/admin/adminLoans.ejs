<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Active Loans & Requests · Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light">

<%- include("partials/adminNavbar") %>

<div class="d-flex gap-4 p-4 align-items-start">
    <%- include("partials/adminSidebar") %>

    <main class="container py-4">

        <% if (error) { %>
            <div class="alert alert-danger d-flex align-items-center gap-2 rounded-4" role="alert">
                <i class="fa-solid fa-triangle-exclamation"></i><span><%= error %></span>
            </div>
        <% } %>
        <% if (success) { %>
            <div class="alert alert-success d-flex align-items-center gap-2 rounded-4" role="alert">
                <i class="fa-solid fa-circle-check"></i><span><%= success %></span>
            </div>
        <% } %>

        <header class="bg-white border rounded-4 p-4 mb-4">
            <span class="text-success fw-bold text-uppercase small">Loan Management</span>
            <h2 class="fw-bold my-1">Requests &amp; Active Loans</h2>
            <p class="text-muted mb-0">Approve or reject pending requests, and track every laptop currently on loan.</p>
        </header>

        <!-- PENDING LOAN REQUESTS -->
        <section class="bg-white border rounded-4 p-4 mb-4">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h5 class="fw-bold mb-0"><i class="fa-solid fa-file-signature me-2 text-primary"></i>Pending Loan Requests</h5>
                <span class="badge bg-warning text-dark rounded-pill"><%= pendingRequests.length %> pending</span>
            </div>

            <% if (pendingRequests.length === 0) { %>
                <p class="text-muted mb-0">No requests are waiting for approval. 🎉</p>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr class="text-muted small text-uppercase">
                                <th>Student</th>
                                <th>Model</th>
                                <th>Reason</th>
                                <th>Remarks</th>
                                <th>Requested On</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% pendingRequests.forEach(function(r) { %>
                                <tr>
                                    <td class="fw-semibold"><%= r.studentName %></td>
                                    <td><%= r.modelName %></td>
                                    <td><%= r.reasonLabel %></td>
                                    <td class="text-muted small"><%= r.remarks || "—" %></td>
                                    <td><%= r.dateLabel %></td>
                                    <td class="text-end">
                                        <form method="POST" action="/admin/loans/requests/<%= r.request_id %>/approve" class="d-inline"
                                              onsubmit="return confirm('Approve this request and create a loan?');">
                                            <button type="submit" class="btn btn-sm btn-success rounded-3">
                                                <i class="fa-solid fa-check me-1"></i>Approve
                                            </button>
                                        </form>
                                        <form method="POST" action="/admin/loans/requests/<%= r.request_id %>/reject" class="d-inline"
                                              onsubmit="return confirm('Reject this request?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-3">
                                                <i class="fa-solid fa-xmark me-1"></i>Reject
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </section>

        <!-- ACTIVE LOANS -->
        <section class="bg-white border rounded-4 p-4">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h5 class="fw-bold mb-0"><i class="fa-solid fa-laptop me-2 text-primary"></i>Active Loans</h5>
                <span class="badge bg-primary rounded-pill"><%= activeLoans.length %> on loan</span>
            </div>

            <% if (activeLoans.length === 0) { %>
                <p class="text-muted mb-0">No laptops are currently on loan.</p>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr class="text-muted small text-uppercase">
                                <th>Loan ID</th>
                                <th>Student</th>
                                <th>Model</th>
                                <th>Borrowed</th>
                                <th>Due</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% activeLoans.forEach(function(l) { %>
                                <tr>
                                    <td class="text-muted small">RP-LOAN-<%= String(l.loan_id).padStart(3, "0") %></td>
                                    <td class="fw-semibold"><%= l.studentName %></td>
                                    <td><%= l.modelName %></td>
                                    <td><%= l.borrowLabel %></td>
                                    <td><%= l.dueLabel %></td>
                                    <td>
                                        <% if (l.overdue) { %>
                                            <span class="badge bg-danger rounded-pill">Overdue by <%= Math.abs(l.daysRemaining) %> day<%= Math.abs(l.daysRemaining) === 1 ? "" : "s" %></span>
                                        <% } else { %>
                                            <span class="badge bg-success rounded-pill">On Loan — <%= l.daysRemaining %> day<%= l.daysRemaining === 1 ? "" : "s" %> left</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </section>

    </main>
</div>
</body>
</html>
