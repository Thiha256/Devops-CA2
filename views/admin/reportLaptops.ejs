<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Laptops · Reports</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light">

<%- include("partials/adminNavbar") %>

<div class="d-flex gap-4 p-4 align-items-start">
    <%- include("partials/adminSidebar") %>

    <main class="container py-4">

        <header class="bg-white border rounded-4 p-4 mb-4">
            <a href="/admin/reports" class="text-success text-decoration-none small">
                <i class="fa-solid fa-arrow-left me-1"></i>Back to Reports
            </a>
            <h2 class="fw-bold my-1">
                <% if (status === "available") { %>Available Laptops
                <% } else if (status === "on loan") { %>Laptops On Loan
                <% } else if (status === "maintenance") { %>Laptops Under Maintenance
                <% } else { %>All Laptops
                <% } %>
            </h2>
            <p class="text-muted mb-0"><%= laptops.length %> laptop<%= laptops.length === 1 ? "" : "s" %> found.</p>
        </header>

        <section class="bg-white border rounded-4 p-4">
            <div class="d-flex flex-wrap gap-2 mb-3">
                <a href="/admin/reports/laptops" class="btn btn-sm rounded-pill <%= !status ? 'btn-dark' : 'btn-outline-dark' %>">All</a>
                <a href="/admin/reports/laptops?status=available" class="btn btn-sm rounded-pill <%= status === 'available' ? 'btn-success' : 'btn-outline-success' %>">Available</a>
                <a href="/admin/reports/laptops?status=on loan" class="btn btn-sm rounded-pill <%= status === 'on loan' ? 'btn-primary' : 'btn-outline-primary' %>">On Loan</a>
                <a href="/admin/reports/laptops?status=maintenance" class="btn btn-sm rounded-pill <%= status === 'maintenance' ? 'btn-secondary' : 'btn-outline-secondary' %>">Maintenance</a>
            </div>

            <% if (laptops.length === 0) { %>
                <p class="text-muted mb-0">No laptops with this status.</p>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr class="text-muted small text-uppercase">
                                <th>Asset ID</th>
                                <th>Model</th>
                                <th>Serial No.</th>
                                <th>Status</th>
                                <th>Borrowed By</th>
                                <th>Due Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% laptops.forEach(function(l) { %>
                                <tr>
                                    <td class="fw-semibold"><%= l.asset_id %></td>
                                    <td><%= l.modelName %></td>
                                    <td class="text-muted small"><%= l.serial_no %></td>
                                    <td>
                                        <% if (l.status === "available") { %>
                                            <span class="badge bg-success rounded-pill">Available</span>
                                        <% } else if (l.status === "on loan") { %>
                                            <span class="badge bg-primary rounded-pill">On Loan</span>
                                        <% } else { %>
                                            <span class="badge bg-secondary rounded-pill">Maintenance</span>
                                        <% } %>
                                    </td>
                                    <td><%= l.borrowerName %></td>
                                    <td>
                                        <%= l.dueLabel %>
                                        <% if (l.overdue) { %>
                                            <span class="badge bg-danger rounded-pill ms-1">Overdue</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </section>

    </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>