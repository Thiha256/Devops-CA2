<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Laptop Rental</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light">

<%- include("partials/adminNavbar") %>

<div class="d-flex gap-4 p-4 align-items-start">
    <%- include("partials/adminSidebar") %>

    <main class="container py-4">

        <a href="/admin" class="text-success text-decoration-none small fw-semibold d-inline-block mb-3">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to Inventory
        </a>

        <!-- summary of models here -->
        <header class="bg-white border rounded-4 p-4 mb-4 d-flex gap-4 align-items-center">
            <% if (model.image_url) { %>
                <img src="<%= model.image_url %>" alt="<%= model.name %>" style="height:80px; width:80px; object-fit:contain;">
            <% } else { %>
                <i class="fa-solid fa-laptop fa-4x text-success"></i>
            <% } %>

            <div class="flex-grow-1">
                <h2 class="fw-bold mb-1"><%= model.name %> <span class="text-muted fw-normal">| Asset Manager</span></h2>
                <p class="text-muted mb-3"><%= model.specs %></p>
                <div class="d-flex flex-wrap gap-2">
                    <span class="badge bg-light text-dark border rounded-pill">Total: <%= model.totalAssets %></span>
                    <span class="badge bg-success rounded-pill">Available: <%= model.availableAssets %></span>
                    <span class="badge bg-primary rounded-pill">Loaned Out: <%= model.loanedAssets %></span>
                    <span class="badge bg-danger rounded-pill">Maintenance: <%= model.maintenanceAssets %></span>
                </div>
            </div>
        </header>

        <!-- list of assets -->
        <section class="bg-white border rounded-4 p-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
                <h5 class="fw-bold mb-0 text-uppercase"><%= model.name %> Asset List</h5>

                <form action="/admin/inventory/<%= model.id %>" method="GET" class="d-flex gap-2">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                        <input type="text" name="q" class="form-control border-start-0 ps-0" placeholder="Find Serial / ID..." value="<%= query %>">
                    </div>
                    <select name="status" class="form-select" onchange="this.form.submit()">
                        <option value="" <%= status === '' ? 'selected' : '' %>>All</option>
                        <option value="available" <%= status === 'available' ? 'selected' : '' %>>Available</option>
                        <option value="on loan" <%= status === 'on loan' ? 'selected' : '' %>>On Loan</option>
                        <option value="maintenance" <%= status === 'maintenance' ? 'selected' : '' %>>Maintenance</option>
                    </select>
                    <button type="submit" class="btn btn-outline-secondary">Search</button>
                    <a href="/admin/inventory/<%= model.id %>/assets/new" class="btn btn-success text-nowrap fw-bold">
                        <i class="fa-solid fa-plus me-1"></i> Add New Asset
                    </a>
                </form>
            </div>

            <% if (assets.length === 0) { %>
                <p class="text-muted text-center py-4 mb-0">No assets match your search.</p>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr class="text-muted small text-uppercase">
                                <th>Asset ID</th>
                                <th>Serial No.</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% assets.forEach(function(asset) { %>
                                <tr>
                                    <td class="fw-semibold"><%= asset.asset_id %></td>
                                    <td><%= asset.serial_no %></td>
                                    <td>
                                        <% if (asset.status === 'available') { %>
                                            <span class="badge bg-success rounded-pill">Available</span>
                                        <% } else if (asset.status === 'on loan') { %>
                                            <span class="badge bg-primary rounded-pill">Loaned Out</span>
                                        <% } else { %>
                                            <span class="badge bg-danger rounded-pill">Maintenance</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <a href="/admin/inventory/<%= model.id %>/assets/<%= asset.laptop_id %>/edit" class="text-success text-decoration-none small fw-semibold me-2"><i class="fa-solid fa-pen me-1"></i>Edit</a>
                                        <form action="/admin/inventory/<%= model.id %>/assets/<%= asset.laptop_id %>/delete" method="POST"
                                              class="d-inline"
                                              onsubmit="return confirm('Delete asset <%= asset.asset_id %>? This cannot be undone.');">
                                            <button type="submit" class="btn btn-link p-0 text-danger text-decoration-none small fw-semibold border-0">
                                                <i class="fa-solid fa-trash me-1"></i>Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </section>

    </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
