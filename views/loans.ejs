<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>My Laptop Rentals</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light">

<%- include("partials/navbar") %>

<div class="d-flex gap-4 p-4 align-items-start">
    <%- include("partials/sidebar") %>

    <main class="flex-grow-1">

        <section class="bg-white border rounded-4 p-4 mb-4">
            <span class="text-success fw-bold text-uppercase small">My Rentals</span>
            <h2 class="fw-bold my-2">My Laptop Rentals</h2>
            <p class="text-muted mb-0">View your current rented laptops and return dates.</p>
        </section>

        <section class="bg-white border rounded-4 p-4">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div class="d-flex align-items-center gap-4">
                    <i class="fa-solid fa-laptop fa-4x text-primary"></i>

                    <div>
                        <h4 class="fw-bold mb-1">Lenovo ThinkPad X13</h4>
                        <p class="text-muted mb-1">Rental ID: RP-LAP-001</p>
                        <p class="mb-1"><strong>Borrow Date:</strong> 25 June 2026</p>
                        <p class="mb-1"><strong>Return Date:</strong> 30 June 2026</p>
                        <span class="badge bg-success rounded-pill">On Loan</span>
                    </div>
                </div>

                <div>
                    <button class="btn btn-outline-danger rounded-3 px-4">Return Laptop</button>
                </div>
            </div>
        </section>

    </main>
</div>

</body>
</html>