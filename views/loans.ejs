<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>My Loans</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light">

<%- include("partials/navbar") %>

<div class="d-flex gap-4 p-4 align-items-start">
    <%- include("partials/sidebar") %>

    <main class="flex-grow-1">

        <section class="bg-white border rounded-4 p-4 mb-4">
            <span class="text-success fw-bold text-uppercase small">My Loans</span>
            <h2 class="fw-bold my-2">Loan Requests & Active Loans</h2>
            <p class="text-muted mb-0">
                Loan requests must be approved by an admin before the laptop is loaned to you.
                Maximum loan period is 1 month.
            </p>
        </section>

        <% if (error) { %>
            <div class="alert alert-danger rounded-4"><i class="fa-solid fa-circle-exclamation me-2"></i><%= error %></div>
        <% } %>
        <% if (success) { %>
            <div class="alert alert-success rounded-4"><i class="fa-solid fa-circle-check me-2"></i><%= success %></div>
        <% } %>

        <section class="bg-white border rounded-4 p-4 mb-4">
            <% const pendingCount = requests.filter(r => r.status === "pending").length; %>
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h5 class="fw-bold mb-0"><i class="fa-solid fa-file-signature me-2 text-primary"></i>My Loan Requests</h5>
                <span class="text-muted small">Pending Requests: <strong><%= pendingCount %></strong></span>
            </div>

            <% if (requests.length === 0) { %>
                <p class="text-muted mb-0">
                    You have no loan requests.
                    <a href="/browse" class="text-success text-decoration-none">Browse laptops</a> to submit one.
                </p>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr class="text-muted small text-uppercase">
                                <th>Model</th>
                                <th>Reason</th>
                                <th>Remarks</th>
                                <th>Start Date</th>
                                <th>Requested On</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% requests.forEach(function(r) { %>
                                <tr>
                                    <td class="fw-semibold"><%= r.modelName %></td>
                                    <td><%= r.reasonLabel %></td>
                                    <td class="text-muted small"><%= r.remarks %></td>
                                    <td><%= r.startLabel %></td>
                                    <td><%= r.dateLabel %></td>
                                    <td>
                                        <% if (r.status === "pending") { %>
                                            <span class="badge bg-warning text-dark rounded-pill">Pending</span>
                                        <% } else if (r.status === "approved") { %>
                                            <span class="badge bg-success rounded-pill">Approved</span>
                                        <% } else { %>
                                            <span class="badge bg-danger rounded-pill">Rejected</span>
                                        <% } %>
                                    </td>
                                    <td class="text-end">
                                        <% if (r.status === "pending") { %>
                                            <form method="POST" action="/loans/request/<%= r.request_id %>/cancel" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-secondary rounded-3">Cancel</button>
                                            </form>
                                            <% if (student.role === "admin") { %>
                                                <form method="POST" action="/dev/requests/<%= r.request_id %>/approve" class="d-inline">
                                                    <button type="submit" class="btn btn-sm btn-outline-success rounded-3">
                                                        Approve
                                                    </button>
                                                </form>
                                            <% } %>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </section>

        <section class="bg-white border rounded-4 p-4">
            <h5 class="fw-bold mb-3"><i class="fa-solid fa-laptop me-2 text-primary"></i>My Laptops</h5>

            <% const activeLoans = loans.filter(l => l.status === "active"); %>
            <% const pastLoans = loans.filter(l => l.status !== "active"); %>

            <% if (activeLoans.length === 0) { %>
                <p class="text-muted mb-0">You have no laptops on loan right now.</p>
            <% } else { %>
                <% activeLoans.forEach(function(l) { %>
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 border rounded-4 p-3 mb-3">
                        <div class="d-flex align-items-center gap-4">
                            <i class="fa-solid fa-laptop fa-3x text-primary"></i>
                            <div>
                                <h5 class="fw-bold mb-1"><%= l.modelName %></h5>
                                <p class="text-muted mb-1 small">Loan ID: RP-LOAN-<%= String(l.loan_id).padStart(3, "0") %></p>
                                <p class="mb-1"><strong>Borrow Date:</strong> <%= l.borrowLabel %></p>
                                <p class="mb-1"><strong>Due Date:</strong> <%= l.dueLabel %></p>
                                <% if (l.overdue) { %>
                                    <span class="badge bg-danger rounded-pill">Overdue by <%= Math.abs(l.daysRemaining) %> day<%= Math.abs(l.daysRemaining) === 1 ? "" : "s" %></span>
                                <% } else { %>
                                    <span class="badge bg-success rounded-pill">On Loan — <%= l.daysRemaining %> day<%= l.daysRemaining === 1 ? "" : "s" %> left</span>
                                <% } %>
                            </div>
                        </div>
                        <div>
                            <form method="POST" action="/loans/<%= l.loan_id %>/return"
                                  onsubmit="return confirm('Return this laptop to the Resource Centre?');">
                                <button type="submit" class="btn btn-outline-danger rounded-3 px-4">Return Laptop</button>
                            </form>
                        </div>
                    </div>
                <% }); %>
            <% } %>

            <% if (pastLoans.length > 0) { %>
                <h6 class="fw-bold text-muted mt-4 mb-2">Past Loans</h6>
                <ul class="list-group list-group-flush">
                    <% pastLoans.forEach(function(l) { %>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span><%= l.modelName %> <span class="text-muted small">(borrowed <%= l.borrowLabel %>)</span></span>
                            <span class="badge bg-secondary rounded-pill">Returned</span>
                        </li>
                    <% }); %>
                </ul>
            <% } %>
        </section>

    </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>