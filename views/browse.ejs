<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Laptop Rental</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light">

<%- include("partials/navbar") %>

<div class="d-flex gap-4 p-4 align-items-start">
    <%- include("partials/sidebar") %>

    <main class="flex-grow-1">

        <section class="bg-white border rounded-4 p-4 mb-4">
            <span class="text-success fw-bold text-uppercase small">Laptop Loans</span>
            <h2 class="fw-bold my-2">Browse Laptop Models</h2>

            <% if (query) { %>
                <p class="text-muted mb-0">
                    Showing <strong><%= models.length %></strong>
                    result<%= models.length === 1 ? "" : "s" %> for "<strong><%= query %></strong>".
                    <a href="/browse" class="text-success text-decoration-none ms-1">Clear</a>
                </p>
            <% } else if (student.role === "admin") { %>
                <p class="text-muted mb-0">
                    Admin view: all laptop models across every school, with live stock and demand.
                </p>
            <% } else { %>
                <p class="text-muted mb-0">
                    Models available to your school (<strong><%= student.school %></strong>).
                    Submit a loan request and an admin will review it.
                </p>
            <% } %>
        </section>

        <% if (error) { %>
            <div class="alert alert-danger rounded-4">
                <i class="fa-solid fa-circle-exclamation me-2"></i><%= error %>
            </div>
        <% } %>

        <% if (success) { %>
            <div class="alert alert-success rounded-4">
                <i class="fa-solid fa-circle-check me-2"></i><%= success %>
            </div>
        <% } %>

        <% if (models.length === 0) { %>
            <section class="bg-white border rounded-4 p-5 text-center">
                <i class="fa-solid fa-magnifying-glass fa-3x text-muted mb-3"></i>
                <h5 class="fw-bold mb-1">No models found</h5>

                <% if (query) { %>
                    <p class="text-muted mb-3">
                        We couldn't find anything matching "<strong><%= query %></strong>".
                    </p>
                    <a href="/browse" class="btn btn-primary rounded-3 px-4">View all models</a>
                <% } else { %>
                    <p class="text-muted mb-0">
                        No laptop models are currently available to your school.
                    </p>
                <% } %>
            </section>
        <% } else { %>
            <section class="row g-4">
                <% models.forEach(function(model) { %>
                    <div class="col-md-4">
                        <div class="bg-white border rounded-4 p-4 h-100 text-center d-flex flex-column">
                            <img src="<%= model.image_url %>" alt="<%= model.name %>"
                                 referrerpolicy="no-referrer"
                                 class="mb-3 mx-auto d-block" style="height: 120px; object-fit: contain;"
                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
                            <i class="fa-solid fa-laptop fa-4x text-primary mb-3" style="display:none;"></i>

                            <h5 class="fw-bold"><%= model.name %></h5>
                            <p class="text-muted small mb-2"><%= model.specs %></p>

                            <div class="mb-3">
                                <% if (model.available > 0) { %>
                                    <span class="badge bg-success rounded-pill">
                                        <%= model.available %> in stock
                                    </span>
                                <% } else { %>
                                    <span class="badge bg-secondary rounded-pill">
                                        Out of stock
                                    </span>
                                <% } %>

                                <% if (model.pending > 0) { %>
                                    <span class="badge bg-warning text-dark rounded-pill">
                                        <%= model.pending %> pending request<%= model.pending === 1 ? "" : "s" %>
                                    </span>
                                <% } %>
                            </div>

                            <% if (student.role === "admin") { %>
                                <p class="text-muted small mb-0 mt-auto">
                                    <strong>Available to schools:</strong>
                                    <%= model.schools.join(", ") %>
                                </p>
                            <% } else { %>
                                <div class="mt-auto">
                                    <button type="button"
                                            class="btn btn-primary rounded-3 px-4"
                                            data-bs-toggle="modal"
                                            data-bs-target="#loanRequestModal"
                                            data-model-id="<%= model.model_id %>"
                                            data-model-name="<%= model.name %>">
                                        Request Loan
                                    </button>
                                </div>
                            <% } %>
                        </div>
                    </div>
                <% }); %>
            </section>
        <% } %>

    </main>
</div>

<% if (student.role !== "admin") { %>
<div class="modal fade" id="loanRequestModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form class="modal-content rounded-4" method="POST" action="/loans/request">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">
                    Request Loan — <span id="loanModalModelName"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" name="model_id" id="loanModalModelId">

                <div class="mb-3">
                    <label for="loanReason" class="form-label fw-semibold">Reason for loan</label>
                    <select class="form-select" id="loanReason" name="reason" required>
                        <option value="" selected disabled>Select a reason…</option>

                        <% Object.keys(reasons).forEach(function(key) { %>
                            <option value="<%= key %>"><%= reasons[key] %></option>
                        <% }); %>
                    </select>
                </div>

                <div class="mb-2">
                    <label for="loanRemarks" class="form-label fw-semibold">
                        Remarks <span class="text-danger">*</span>
                    </label>
                    <textarea class="form-control"
                              id="loanRemarks"
                              name="remarks"
                              rows="3"
                              required
                              placeholder="Briefly explain your situation (required)"></textarea>

                    <div class="form-text">
                        Note: if your laptop is under maintenance, proof (e.g. repair receipt)
                        must be shown in person at the Resource Centre.
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">
                    Cancel
                </button>
                <button type="submit" class="btn btn-primary rounded-3 px-4">
                    Submit Request
                </button>
            </div>
        </form>
    </div>
</div>
<% } %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<% if (student.role !== "admin") { %>
<script>
    const loanModal = document.getElementById("loanRequestModal");

    loanModal.addEventListener("show.bs.modal", function (event) {
        const button = event.relatedTarget;

        document.getElementById("loanModalModelId").value = button.getAttribute("data-model-id");
        document.getElementById("loanModalModelName").textContent = button.getAttribute("data-model-name");

    });
</script>
<% } %>

</body>
</html>