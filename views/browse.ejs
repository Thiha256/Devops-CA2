<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Laptop Rental</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light">

<%- include("partials/navbar") %>

<div class="d-flex gap-4 p-4 align-items-start">
    <%- include("partials/sidebar") %>

    <main class="flex-grow-1">

        <section class="bg-white border rounded-4 p-4 mb-4">
            <span class="text-success fw-bold text-uppercase small">Laptop Rental</span>
            <h2 class="fw-bold my-2">Browse Available Devices</h2>
            <% if (query) { %>
                <p class="text-muted mb-0">
                    Showing <strong><%= devices.length %></strong>
                    result<%= devices.length === 1 ? "" : "s" %> for "<strong><%= query %></strong>".
                    <a href="/browse" class="text-success text-decoration-none ms-1">Clear</a>
                </p>
            <% } else { %>
                <p class="text-muted mb-0">Choose a device and submit a rental request.</p>
            <% } %>
        </section>

        <% if (devices.length === 0) { %>
            <section class="bg-white border rounded-4 p-5 text-center">
                <i class="fa-solid fa-magnifying-glass fa-3x text-muted mb-3"></i>
                <h5 class="fw-bold mb-1">No devices found</h5>
                <p class="text-muted mb-3">We couldn't find anything matching "<strong><%= query %></strong>".</p>
                <a href="/browse" class="btn btn-primary rounded-3 px-4">View all devices</a>
            </section>
        <% } else { %>
            <section class="row g-4">
                <% devices.forEach(function(device) { %>
                    <div class="col-md-4">
                        <div class="bg-white border rounded-4 p-4 h-100 text-center">
                            <i class="fa-solid <%= device.icon %> fa-4x text-primary mb-3"></i>
                            <h5 class="fw-bold"><%= device.name %></h5>
                            <p class="text-muted small mb-2"><%= device.specs %></p>
                            <% if (device.status === "Available") { %>
                                <span class="badge bg-success rounded-pill mb-3"><%= device.status %></span>
                            <% } else if (device.status === "Limited") { %>
                                <span class="badge bg-warning text-dark rounded-pill mb-3"><%= device.status %></span>
                            <% } else { %>
                                <span class="badge bg-secondary rounded-pill mb-3"><%= device.status %></span>
                            <% } %>
                            <br>
                            <a href="/loans" class="btn btn-primary rounded-3 px-4">Rent Now</a>
                        </div>
                    </div>
                <% }); %>
            </section>
        <% } %>

    </main>
</div>

</body>
</html>