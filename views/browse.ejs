<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Laptop Rental</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light">

<%- include("partials/navbar") %>

<div class="d-flex gap-4 p-4 align-items-start">
    <%- include("partials/sidebar") %>

    <main class="flex-grow-1">

        <section class="bg-white border rounded-4 p-4 mb-4">
            <span class="text-success fw-bold text-uppercase small">Laptop Rental</span>
            <h2 class="fw-bold my-2">Browse Available Laptops</h2>
            <p class="text-muted mb-0">Choose a laptop and submit a rental request.</p>
        </section>

        <section class="row g-4">
            <div class="col-md-4">
                <div class="bg-white border rounded-4 p-4 h-100 text-center">
                    <i class="fa-solid fa-laptop fa-4x text-primary mb-3"></i>
                    <h5 class="fw-bold">Lenovo ThinkPad X13</h5>
                    <p class="text-muted small">Intel i5, 16GB RAM, 512GB SSD</p>
                    <span class="badge bg-success rounded-pill mb-3">Available</span>
                    <br>
                    <a href="/loans" class="btn btn-primary rounded-3 px-4">Rent Now</a>
                </div>
            </div>

            <div class="col-md-4">
                <div class="bg-white border rounded-4 p-4 h-100 text-center">
                    <i class="fa-solid fa-laptop fa-4x text-primary mb-3"></i>
                    <h5 class="fw-bold">Dell Latitude 5440</h5>
                    <p class="text-muted small">Intel i7, 16GB RAM, 512GB SSD</p>
                    <span class="badge bg-success rounded-pill mb-3">Available</span>
                    <br>
                    <a href="/loans" class="btn btn-primary rounded-3 px-4">Rent Now</a>
                </div>
            </div>

            <div class="col-md-4">
                <div class="bg-white border rounded-4 p-4 h-100 text-center">
                    <i class="fa-solid fa-laptop fa-4x text-primary mb-3"></i>
                    <h5 class="fw-bold">HP EliteBook 840</h5>
                    <p class="text-muted small">Intel i5, 8GB RAM, 256GB SSD</p>
                    <span class="badge bg-warning text-dark rounded-pill mb-3">Limited</span>
                    <br>
                    <a href="/loans" class="btn btn-primary rounded-3 px-4">Rent Now</a>
                </div>
            </div>
        </section>

    </main>
</div>

</body>
</html>