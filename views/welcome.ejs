<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome to RP Resource Centre</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light welcome-page-body">
    <nav class="navbar navbar-expand-lg bg-white border-bottom sticky-top px-4 py-3 shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center gap-3" href="/welcome">
                <img src="/images/rp-logo.png" alt="Republic Polytechnic Logo" style="height:42px;">
                <div>
                    <h5 class="mb-0 fw-bold">RP Resource Centre</h5>
                    <small class="text-success fw-semibold">Republic Polytechnic</small>
                </div>
            </a>

            <div class="d-flex align-items-center gap-2">
                <a href="#about" class="nav-link text-dark fw-semibold">About</a>
            </div>
        </div>
    </nav>

    <div class="container py-4 py-md-5">
        <div class="row justify-content-center">
            <div class="col-lg-11">
                <div class="welcome-card rounded-4 border bg-white shadow-sm p-3 p-md-4">
                    <div class="row align-items-center g-3">
                        <div class="col-lg-5 text-center text-lg-start">
                            <div class="welcome-logo mb-2">
                                <img src="/images/rp-logo.png" alt="Republic Polytechnic Logo">
                            </div>
                        </div>

                        <div class="col-lg-7">
                            <span class="text-success fw-bold text-uppercase small">RP Resource Centre</span>
                            <h1 class="fw-bold mt-2 mb-2">Welcome to Republic Polytechnic's digital resource hub</h1>
                            <p class="welcome-description mb-0">
                                This website helps students easily discover and manage available devices,
                                track loans, and stay updated on school resource services in one simple place.
                            </p>

                        </div>
                    </div>

                    <div class="row g-3 mt-3">
                        <div class="col-12">
                            <div class="welcome-actions justify-content-center mt-2">
                                <a href="/login/student" class="btn btn-success btn-lg rounded-pill px-5 py-3 modern-btn">Log in as RP student</a>
                                <a href="/login/admin" class="btn btn-outline-success btn-lg rounded-pill px-5 py-3 modern-btn">Log in as an admin account</a>
                            </div>
                        </div>

                        <div class="col-sm-6 col-lg-3">
                            <div class="feature-box">
                                <div class="feature-icon">📱</div>
                                <h6 class="fw-bold mb-1">Device Access</h6>
                                <p class="mb-0">Browse laptops and tablets quickly.</p>
                            </div>
                        </div>
                        <div class="col-sm-6 col-lg-3">
                            <div class="feature-box">
                                <div class="feature-icon">📝</div>
                                <h6 class="fw-bold mb-1">Loan Tracking</h6>
                                <p class="mb-0">Monitor your active loans and due dates.</p>
                            </div>
                        </div>
                        <div class="col-sm-6 col-lg-3">
                            <div class="feature-box">
                                <div class="feature-icon">🛠️</div>
                                <h6 class="fw-bold mb-1">Device Care</h6>
                                <p class="mb-0">Guidelines to keep your loaned device in top shape.</p>
                            </div>
                        </div>
                        <div class="col-sm-6 col-lg-3">
                            <div class="feature-box">
                                <div class="feature-icon">💡</div>
                                <h6 class="fw-bold mb-1">Support Ready</h6>
                                <p class="mb-0">Get help whenever you need it.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
