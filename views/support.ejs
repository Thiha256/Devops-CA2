<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="rp-app-bg">

<%- include("partials/navbar") %>

<div class="d-flex gap-4 p-4 align-items-start">
    <%- include("partials/sidebar") %>

    <main class="flex-grow-1">

        <!-- Page Header -->
        <section class="rp-hero-banner rp-hero-photo rp-hero-support border rounded-4 p-4 mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <span class="rp-hero-eyebrow fw-bold text-uppercase small">Help Centre</span>
                <h2 class="fw-bold my-2">Support</h2>
                <p class="mb-0" style="max-width:560px;">Need help with a booking or loan? Reach out to us or check the FAQs below.</p>
            </div>
        </section>

        <section class="row g-3 mb-4">

            <!-- Contact Options -->
            <div class="col-lg-4">
                <div class="bg-white border rounded-4 p-4 h-100">
                    <h4 class="fw-bold mb-3">Contact Us</h4>

                    <div class="d-flex align-items-start gap-3 mb-3">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-3 d-flex align-items-center justify-content-center flex-shrink-0" style="width:44px;height:44px;">
                            <i class="fa-solid fa-envelope"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Email</h6>
                            <p class="text-muted small mb-0">resourcecentre@rp.edu.sg</p>
                        </div>
                    </div>

                    <div class="d-flex align-items-start gap-3 mb-3">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-3 d-flex align-items-center justify-content-center flex-shrink-0" style="width:44px;height:44px;">
                            <i class="fa-solid fa-phone"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Phone</h6>
                            <p class="text-muted small mb-0">+65 6510 3000</p>
                        </div>
                    </div>

                    <div class="d-flex align-items-start gap-3 mb-4">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-3 d-flex align-items-center justify-content-center flex-shrink-0" style="width:44px;height:44px;">
                            <i class="fa-solid fa-location-dot"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Location</h6>
                            <p class="text-muted small mb-0">Resource Centre, Block C, Level 1</p>
                        </div>
                    </div>

                    <div class="bg-light border rounded-3 p-3">
                        <h6 class="text-success mb-1" style="font-size:13px;">Operating Hours</h6>
                        <p class="text-muted mb-0" style="font-size:11.5px;">Mon - Fri<br>8:30AM - 6:00PM</p>
                    </div>
                </div>
            </div>

            <!-- Contact Form -->
            <div class="col-lg-8">
                <div class="bg-white border rounded-4 p-4 h-100">
                    <h4 class="fw-bold mb-3">Send Us a Message</h4>

                    <form id="supportForm" action="/support" method="POST">
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label class="form-label small fw-semibold">Name</label>
                                <input type="text" class="form-control bg-light" value="<%= student.name %>" readonly>
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label small fw-semibold">Student ID</label>
                                <input type="text" class="form-control bg-light" value="<%= student.id %>" readonly>
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Subject</label>
                                <select class="form-select" name="subject" required>
                                    <option value="Booking Issue">Booking Issue</option>
                                    <option value="Loan Extension">Loan Extension</option>
                                    <option value="Penalty Dispute">Penalty Dispute</option>
                                    <option value="Device Fault">Device Fault</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Message</label>
                                <textarea class="form-control" name="message" rows="5" placeholder="Describe your issue..." required></textarea>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary rounded-3 px-4">Submit Request</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

        </section>

        <!-- FAQ -->
        <section class="bg-white border rounded-4 p-4">
            <h4 class="fw-bold mb-3">Frequently Asked Questions</h4>

            <div class="accordion" id="faqAccordion">

                <div class="accordion-item border-0 border-bottom">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                            How do I extend my device loan?
                        </button>
                    </h2>
                    <div id="faq1" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted small">
                            Go to <strong>My Loans</strong> and click "Request Extension" on the device you currently have on loan, at least 1 day before the due date.
                        </div>
                    </div>
                </div>

                <div class="accordion-item border-0 border-bottom">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                            What happens if I return a device late?
                        </button>
                    </h2>
                    <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted small">
                            A penalty will be added to your account under <strong>Penalties</strong>. Overdue devices are charged per day until returned.
                        </div>
                    </div>
                </div>

                <div class="accordion-item border-0 border-bottom">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                            How many devices can I book at once?
                        </button>
                    </h2>
                    <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted small">
                            Students can have a maximum of 1 active loan at a time. Return your current device before booking another.
                        </div>
                    </div>
                </div>

                <div class="accordion-item border-0">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#faq4">
                            My device is faulty. What should I do?
                        </button>
                    </h2>
                    <div id="faq4" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted small">
                            Select "Device Fault" in the contact form above and describe the issue. Bring the device to the Resource Centre for inspection.
                        </div>
                    </div>
                </div>

            </div>
        </section>

    </main>
</div>

<%- include("partials/footer") %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const supportForm = document.getElementById('supportForm');
        if (supportForm) {
            supportForm.addEventListener('submit', function (event) {
                if (supportForm.dataset.rpConfirmed === '1') return;
                event.preventDefault();

                RP.confirm('Do you want to submit this support request?', {
                    title: 'Submit request?',
                    confirmLabel: 'Submit',
                    danger: false
                }).then(function (ok) {
                    if (ok) {
                        supportForm.dataset.rpConfirmed = '1';
                        supportForm.submit();
                    }
                });
            });
        }

        <% if (submitted) { %>
            RP.toast('Your support request has been submitted successfully.', 'success');
        <% } %>
    });
</script>
</body>
</html>