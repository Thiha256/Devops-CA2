<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Support</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-light">

<%- include("partials/navbar") %>

<div class="d-flex gap-4 p-4 align-items-start">

    <%- include("partials/sidebar") %>

    <main class="flex-grow-1">

        <!-- Header -->
        <section class="bg-white border rounded-4 p-4 mb-4">
            <span class="text-success fw-bold text-uppercase small">
                RP Resource Centre
            </span>

            <h2 class="fw-bold mt-2">
                Contact & Support
            </h2>

            <p class="text-muted mb-0">
                Need help with laptop rentals or your account? Contact the RP Resource Centre.
            </p>
        </section>

        <div class="row g-4">

            <!-- Contact Information -->
            <div class="col-lg-6">

                <div class="bg-white border rounded-4 p-4 h-100">

                    <h4 class="fw-bold mb-4">
                        Contact Information
                    </h4>

                    <p>
                        <i class="fa-solid fa-location-dot text-success me-2"></i>
                        Republic Polytechnic<br>
                        9 Woodlands Avenue 9<br>
                        Singapore 738964
                    </p>

                    <p>
                        <i class="fa-solid fa-phone text-success me-2"></i>
                        +65 6510 3000
                    </p>

                    <p>
                        <i class="fa-solid fa-envelope text-success me-2"></i>
                        enquiry@rp.edu.sg
                    </p>

                    <p>
                        <i class="fa-solid fa-clock text-success me-2"></i>
                        Monday – Friday<br>
                        8:30 AM – 6:00 PM
                    </p>

                </div>

            </div>

            <!-- FAQs -->
            <div class="col-lg-6">

                <div class="bg-white border rounded-4 p-4 h-100">

                    <h4 class="fw-bold mb-4">
                        Frequently Asked Questions
                    </h4>

                    <div class="mb-3">
                        <h6 class="fw-bold">
                            How do I rent a laptop?
                        </h6>

                        <p class="text-muted">
                            Browse the available laptops and click "Rent Now".
                        </p>
                    </div>

                    <div class="mb-3">
                        <h6 class="fw-bold">
                            How long can I borrow a laptop?
                        </h6>

                        <p class="text-muted">
                            Students may borrow laptops according to RP Resource Centre policies.
                        </p>
                    </div>

                    <div class="mb-3">
                        <h6 class="fw-bold">
                            What happens if I return it late?
                        </h6>

                        <p class="text-muted">
                            Late returns may result in penalties or temporary suspension of borrowing privileges.
                        </p>
                    </div>

                </div>

            </div>

        </div>

    </main>

</div>

</body>
</html>