<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Notifications</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="rp-app-bg">

<%- include("partials/navbar") %>

<%
    // Map a notification type to a Font Awesome icon + colour for the list.
    function styleFor(type) {
        switch (type) {
            case 'request_submitted': return { icon: 'fa-paper-plane',        colour: 'primary' };
            case 'request_approved':  return { icon: 'fa-circle-check',        colour: 'success' };
            case 'request_rejected':  return { icon: 'fa-circle-xmark',        colour: 'danger'  };
            case 'loan_returned':     return { icon: 'fa-rotate-left',         colour: 'secondary' };
            case 'loan_due_soon':     return { icon: 'fa-clock',               colour: 'warning' };
            case 'loan_overdue':      return { icon: 'fa-triangle-exclamation',colour: 'danger'  };
            case 'fine_issued':       return { icon: 'fa-money-bill-wave',     colour: 'danger'  };
            default:                  return { icon: 'fa-bell',                colour: 'success' };
        }
    }
%>

<div class="d-flex gap-4 p-4 align-items-start">
    <%- include("partials/sidebar") %>

    <main class="flex-grow-1">
        <section class="bg-white border rounded-4 p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold mb-0">Notifications</h4>
                <span class="badge bg-secondary rounded-pill"><%= notifications.length %></span>
            </div>

            <% if (notifications.length === 0) { %>
                <p class="text-muted text-center py-5 mb-0">You have no notifications yet.</p>
            <% } else { %>
                <ul class="list-unstyled mb-0">
                    <% notifications.forEach(function (n) {
                        const s = styleFor(n.type); %>
                        <li class="d-flex gap-3 align-items-start border-bottom py-3">
                            <div class="rounded-circle bg-<%= s.colour %> bg-opacity-10 text-<%= s.colour %> d-flex align-items-center justify-content-center flex-shrink-0" style="width:42px;height:42px;">
                                <i class="fa-solid <%= s.icon %>"></i>
                            </div>
                            <div class="flex-grow-1">
                                <p class="mb-1"><%= n.message %></p>
                                <small class="text-muted"><%= new Date(n.created_at).toLocaleString('en-SG') %></small>
                            </div>
                        </li>
                    <% }); %>
                </ul>
            <% } %>
        </section>
    </main>
</div>

<%- include("partials/footer") %>

</body>
</html>
