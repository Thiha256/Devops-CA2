<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RP Resource Centre</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light">

<%- include("partials/navbar") %>

<div class="d-flex gap-4 p-4 align-items-start">
    <%- include("partials/sidebar") %>

    <main class="flex-grow-1">

        <!-- Hero -->
        <section class="bg-white border rounded-4 p-4 mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <span class="text-success fw-bold text-uppercase small">RP Resource Centre</span>
                <h2 class="fw-bold my-2">Welcome back, <%= student.name %> 👋</h2>
                <p class="text-muted mb-0" style="max-width:560px;">Manage your bookings, active loans and overdue penalties from one place.</p>
            </div>
            <a href="/browse" class="btn btn-primary rounded-3 px-4 py-2">Browse Devices</a>
        </section>

        <!-- Stats -->
        <section class="row g-3 mb-4">
            <div class="col-6 col-lg-3">
                <div class="bg-white border rounded-4 p-3 border-start border-success border-4">
                    <h3 class="fw-bold mb-1"><%= stats.available %></h3>
                    <p class="text-muted small mb-0">Available Devices</p>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="bg-white border rounded-4 p-3 border-start border-success border-4">
                    <h3 class="fw-bold mb-1"><%= stats.loans %></h3>
                    <p class="text-muted small mb-0">Current Loans</p>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="bg-white border rounded-4 p-3 border-start border-success border-4">
                    <h3 class="fw-bold mb-1"><%= stats.penalties %></h3>
                    <p class="text-muted small mb-0">Outstanding Penalties</p>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="bg-white border rounded-4 p-3 stat-gold">
                    <h3 class="fw-bold mb-1"><%= loan.daysRemaining %></h3>
                    <p class="text-muted small mb-0">Days Remaining</p>
                </div>
            </div>
        </section>

        <!-- Loan + Quick Actions -->
        <section class="row g-3 mb-4">
            <div class="col-lg-4">
                <div class="bg-white border rounded-4 p-4 text-center h-100 d-flex flex-column align-items-center">
                    <div class="bg-primary bg-opacity-10 text-success rounded-4 d-inline-flex align-items-center justify-content-center mb-3" style="width:130px;height:130px;font-size:60px;">
                        <i class="fa-solid fa-laptop"></i>
                    </div>
                    <span class="badge bg-success rounded-pill px-3 py-2 mb-3"><%= loan.status %></span>
                    <h4 class="fw-bold mb-3"><%= loan.device %></h4>
                    <p class="text-muted small mb-1">Due Date</p>
                    <h6 class="fw-bold mb-4"><%= loan.dueDate %></h6>
                    <a href="/loans" class="btn btn-primary rounded-3 px-4 mt-auto">View Loan Details</a>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="bg-white border rounded-4 p-4 h-100">
                    <h4 class="fw-bold mb-3">Quick Actions</h4>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <a href="/browse" class="d-block bg-light border rounded-3 p-3 text-decoration-none text-dark h-100">
                                <div class="bg-primary bg-opacity-10 text-primary rounded-3 d-inline-flex align-items-center justify-content-center mb-3" style="width:44px;height:44px;">
                                    <i class="fa-solid fa-laptop"></i>
                                </div>
                                <h6 class="fw-bold mb-1">Browse Devices</h6>
                                <p class="text-muted small mb-0">Reserve laptops and accessories.</p>
                            </a>
                        </div>
                        <div class="col-sm-6">
                            <a href="/loans" class="d-block bg-light border rounded-3 p-3 text-decoration-none text-dark h-100">
                                <div class="bg-primary bg-opacity-10 text-primary rounded-3 d-inline-flex align-items-center justify-content-center mb-3" style="width:44px;height:44px;">
                                    <i class="fa-solid fa-book"></i>
                                </div>
                                <h6 class="fw-bold mb-1">My Loans</h6>
                                <p class="text-muted small mb-0">View all active loans.</p>
                            </a>
                        </div>
                        <div class="col-sm-6">
                            <a href="/support" class="d-block bg-light border rounded-3 p-3 text-decoration-none text-dark h-100">
                                <div class="bg-primary bg-opacity-10 text-primary rounded-3 d-inline-flex align-items-center justify-content-center mb-3" style="width:44px;height:44px;">
                                    <i class="fa-solid fa-headset"></i>
                                </div>
                                <h6 class="fw-bold mb-1">Support</h6>
                                <p class="text-muted small mb-0">Need help? Contact us.</p>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Notices -->
        <section class="bg-white border rounded-4 p-4">
            <h4 class="fw-bold mb-3">Latest Notices</h4>
            <ul class="list-unstyled mb-0">
                <li class="mb-2 text-secondary">📢 Resource Centre Operating Hours: Monday - Friday (8:30AM - 6:00PM)</li>
                <li class="mb-2 text-secondary">💻 New Lenovo ThinkPads are available for booking.</li>
                <li class="mb-0 text-secondary">⚠ Return devices on time to avoid overdue penalties.</li>
            </ul>
        </section>

    </main>
</div>

</body>
</html>