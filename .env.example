# Copy this file to `.env` and fill in your local MySQL credentials.
# `.env` is gitignored so your real password is never committed.
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_DATABASE=resource_centre_db

# --- Notifications (n8n) ---
# n8n Webhook URL that receives event payloads and sends the Gmail email.
# Leave blank to run without n8n (in-app notifications still work).
N8N_WEBHOOK_URL=
# Shared secret the scheduled n8n workflow must pass to trigger reminder emails,
# e.g. GET /api/notifications/run-reminders?token=YOUR_SECRET
CRON_SECRET=change-me

# --- Fines ---
FINE_RATE_PER_DAY=1   # dollars charged per day a return is late
DUE_SOON_DAYS=2       # how many days before due date counts as "due soon"

# --- Low inventory alerts (n8n) ---
LOW_STOCK_THRESHOLD=2            # alert when a model's available units <= this
ADMIN_ALERT_EMAIL=              # inbox that receives low-stock alert emails
