{
  "name": "RP Resource Centre - Daily Reminders",
  "active": false,
  "settings": {},
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 8,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "node-schedule",
      "name": "Every day 8am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [360, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:3001/api/notifications/run-reminders",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "token", "value": "change-me" }
          ]
        },
        "options": {}
      },
      "id": "node-http",
      "name": "Get due-soon loans",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [580, 300]
    },
    {
      "parameters": {
        "fieldToSplitOut": "notifications",
        "options": {}
      },
      "id": "node-split",
      "name": "Split notifications",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [800, 300]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "=RP Resource Centre - Loan Reminder",
        "emailType": "text",
        "message": "=Hi {{ $json.name }},\n\n{{ $json.message }}\n\n- RP Resource Centre",
        "options": {}
      },
      "id": "node-gmail",
      "name": "Send Email (Gmail)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1020, 300],
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_YOUR_GMAIL_CREDENTIAL",
          "name": "Gmail account"
        }
      }
    }
  ],
  "connections": {
    "Every day 8am": {
      "main": [
        [ { "node": "Get due-soon loans", "type": "main", "index": 0 } ]
      ]
    },
    "Get due-soon loans": {
      "main": [
        [ { "node": "Split notifications", "type": "main", "index": 0 } ]
      ]
    },
    "Split notifications": {
      "main": [
        [ { "node": "Send Email (Gmail)", "type": "main", "index": 0 } ]
      ]
    }
  }
}
