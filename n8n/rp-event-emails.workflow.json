{
  "name": "RP Resource Centre - Event Emails",
  "active": false,
  "settings": {},
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "rp-notify",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "node-webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [400, 300],
      "webhookId": "rp-notify"
    },
    {
      "parameters": {
        "sendTo": "={{ $json.body.email }}",
        "subject": "=RP Resource Centre - {{ $json.body.type }}",
        "emailType": "text",
        "message": "=Hi {{ $json.body.name }},\n\n{{ $json.body.message }}\n\n- RP Resource Centre",
        "options": {}
      },
      "id": "node-gmail",
      "name": "Send Email (Gmail)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [640, 300],
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_YOUR_GMAIL_CREDENTIAL",
          "name": "Gmail account"
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          { "node": "Send Email (Gmail)", "type": "main", "index": 0 }
        ]
      ]
    }
  }
}
